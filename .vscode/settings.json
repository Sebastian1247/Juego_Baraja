{
    "java.project.sourcePaths": ["src"],
    "java.project.outputPath": "bin",
    "java.project.referencedLibraries": [
        "lib/**/*.jar"
    ],
    "terminal.integrated.profiles.windows": {
        "PowerShell UTF-8": {
            "source": "PowerShell",
            "args": ["-NoExit", "-Command", "chcp 65001 > $null; [Console]::OutputEncoding = [Text.Encoding]::UTF8"]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell UTF-8",
    "code-runner.executorMap": {
        "java": "cd \"$workspaceRoot\"; javac -encoding UTF-8 -d bin src/*.java; if ($?) { java -cp bin App }"
    },
    "code-runner.runInTerminal": true
}
